{
  "name": "cornell-swing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler pages dev --env-file check-in/.dev.vars",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pages:types": "wrangler types pages-configuration.d.ts --config wrangler.jsonc --include-runtime false --env-interface PagesEnv",
    "worker:types": "wrangler types worker-configuration.d.ts --config wrangler.cron.jsonc --env-file check-in/dev.vars.example",
    "worker:check": "npm run build && wrangler pages functions build functions --outdir .wrangler/pages-functions && wrangler deploy --dry-run --config wrangler.cron.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy",
    "deploy:sync": "wrangler deploy --config wrangler.cron.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@msw/cloudflare": "^0.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
