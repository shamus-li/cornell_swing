{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swing-syndicate",
  "account_id": "826a8805e6c445803da24e740d6912e3",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "swingsyndicate.club",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "MEMBER_CACHE",
      "id": "694f8558f39b4980ac32b596cb92e858"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHECKIN_GUARD",
        "class_name": "CheckinGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "CheckinGuard"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "MEMBER_SEARCH_RATE_LIMITER",
      "namespace_id": "20260827",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "RSVP_RATE_LIMITER",
      "namespace_id": "20260920",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "NOTION_MEMBERS_DATA_SOURCE_ID": "6963065b-1352-4663-bf1a-fb3ed656e018",
    "NOTION_EVENTS_DATA_SOURCE_ID": "687e0df9-8bc6-4383-99b0-9a7ffcbaf5a5",
    "GOOGLE_SPREADSHEET_ID": "1LolWpgKRUjYE45S3UrxWLPqtek0FfEmlcbKNr4Mm2AQ",
    "GOOGLE_SHEET_NAME": "Check-ins",
    "TIME_ZONE": "America/New_York",
    "ACCESS_TEAM_DOMAIN": "swing-syndicate-cornell.cloudflareaccess.com",
    "ACCESS_AUD": "edff3a8c97b455c985deb5d34b4cfd6f81fc603b92aa4c3f0fe694434f556229"
  },
  "secrets": {
    "required": [
      "NOTION_TOKEN",
      "GOOGLE_SERVICE_ACCOUNT_EMAIL",
      "GOOGLE_PRIVATE_KEY",
      "GOOGLE_PLACES_API_KEY"
    ]
  },
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "EVENTS_DB",
      "database_name": "swing-events",
      "database_id": "795e402f-8af3-4b97-8bd8-781a1cb71371",
      "migrations_dir": "migrations/events"
    }
  ]
}
